@inproceedings{blohm2026hotfuzz,
  title     = {Composition of Pretrained Diffusion Models: A Logic-Based Calculus},
  author    = {Blohm, Peter and Garg, Vikas K.},
  booktitle = {International Conference on Learning Representations (ICLR)},
  year      = {2026},
  note      = {ICLR 2026 Poster},
  abbr      = {ICLR},
  url       = {https://openreview.net/forum?id=ADLiUSC7Qm},
  pdf       = {https://openreview.net/pdf?id=ADLiUSC7Qm},
  code      = {https://github.com/Aalto-QuML/logic-diffusion-composition},
  abstract  = {Composing pretrained diffusion models provides a cost-effective mechanism to encode constraints and unlock complex generative capabilities. Prior work relies on set-theoretic composition operators but suffers from limited mode coverage, biased sampling, instability under negation queries, and violations of core compositional laws. We introduce a principled calculus grounded in fuzzy logic, defining conjunction, disjunction, and negation operators that generalize classical mixtures and avoid these pathologies. Beyond existing methods, Dombi operators enable richer compositions such as Exclusive-OR, and we derive Feynman-Kac correctors to mitigate sampling bias. Empirical results on image generation with Stable Diffusion and multi-objective molecular generation support the conceptual, theoretical, and methodological benefits.},
  selected  = {true},
  blog      = {/blog/2026/hot-fuzz/},
  preview   = {hotfuzz.png}
}

